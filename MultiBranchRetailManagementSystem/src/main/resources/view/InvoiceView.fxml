<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>

<VBox spacing="12"
      alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.InvoiceController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>


    <Label text="INVOICE"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="8">
        <Label text="Invoice ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="invoiceIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="dateLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Customer:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="customerNameLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Phone:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="customerPhoneLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Employee:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="employeeNameLabel" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Branch:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Label fx:id="branchNameLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <TableView fx:id="invoiceTable" prefHeight="300">
        <columns>
            <TableColumn fx:id="colProduct" text="Product" prefWidth="200"/>
            <TableColumn fx:id="colQty" text="Qty" prefWidth="80"/>
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
        </columns>
    </TableView>

    <Label fx:id="totalLabel"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Print PDF" onAction="#handlePrint"/>
        <Button text="Back" onAction="#handleBack"/>
    </HBox>

</VBox>
