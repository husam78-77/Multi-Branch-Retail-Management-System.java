<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ReportController"
            style="-fx-background-color: #f5f5f5;"
            minHeight="600"
            minWidth="800">

    <top>
        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📊" style="-fx-font-size: 28px;"/>
                <VBox spacing="3">
                    <Label text="Sales Per Branch Report"
                           style="-fx-font-size: 20px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"/>
                    <Label text="View total sales performance by branch location"
                           style="-fx-font-size: 13px; 
                                  -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" 
                    style="-fx-background-color: transparent; 
                           -fx-background: transparent;">
            <VBox alignment="CENTER" spacing="15">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <!-- Report Card Container -->
                <VBox style="-fx-background-color: white; 
                            -fx-background-radius: 10;
                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      maxWidth="900"
                      minHeight="400">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    
                    <!-- Table -->
					<TableView fx:id="branchReportTable"
					           prefHeight="400"
					           VBox.vgrow="ALWAYS"
					           style="
					               -fx-background-color: transparent;
					               -fx-text-background-color: black;
					           ">

                        
                        <columns>
						    <TableColumn fx:id="colBranch"
						                 text="Branch Name"
						                 prefWidth="400"
						                 style="-fx-alignment: CENTER-LEFT; -fx-text-fill: black;"/>
						
						    <TableColumn fx:id="colTotal"
						                 text="Total Sales (RM)"
						                 prefWidth="300"
						                 style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: black;"/>
                        </columns>

                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" 
              spacing="10"
              style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <Button text="📄 Download PDF" 
                    onAction="#handleDownloadPDF"
                    style="-fx-background-color: #e74c3c; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="← Back" 
                    onAction="#handleBack"
                    style="-fx-background-color: #95a5a6; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
