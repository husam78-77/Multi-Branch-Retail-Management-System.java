<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BranchController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🏢" style="-fx-font-size: 24px;"/>
                <Label text="Branch Management"
                       style="-fx-font-size: 20px; 
                              -fx-font-weight: bold; 
                              -fx-text-fill: #2c3e50;"/>
            </HBox>
            
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets top="15"/>
                </VBox.margin>
                
                <TextField fx:id="searchField"
                           promptText="Search by branch name..."
                           prefWidth="350"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <Button text="🔍 Search" 
                        onAction="#handleSearch"
                        style="-fx-background-color: #3498db; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
                <Button text="🔄 Refresh" 
                        onAction="#loadBranches"
                        style="-fx-background-color: #95a5a6; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets top="15" right="15" bottom="0" left="15"/>
            </padding>
            
            <TableView fx:id="branchTable"
                       style="-fx-background-color: white; 
                              -fx-background-radius: 8;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1);">
                <columns>
                    <TableColumn fx:id="colId" 
                                 text="ID" 
                                 prefWidth="80"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colName" 
                                 text="Branch Name" 
                                 prefWidth="250"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="colCity" 
                                 text="City" 
                                 prefWidth="200"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colPhone" 
                                 text="Phone Number" 
                                 prefWidth="180"
                                 style="-fx-alignment: CENTER;"/>
					<TableColumn fx:id="colStatus" text="Status" 
								 prefWidth="180"
                                 style="-fx-alignment: CENTER;"/>

                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <VBox style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            
            <!-- Form Title -->
            <Label text="Branch Details"
                   style="-fx-font-size: 15px; 
                          -fx-font-weight: 600; 
                          -fx-text-fill: #34495e;">
                <VBox.margin>
                    <Insets bottom="15"/>
                </VBox.margin>
            </Label>
            
            <!-- Form Fields -->
            <GridPane hgap="15" vgap="12">
                
                <!-- Branch Name -->
                <Label text="Branch Name" 
                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="nameField" 
                           promptText="Enter branch name"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"
                           prefWidth="280"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- City -->
                <Label text="City" 
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="cityField" 
                           promptText="Enter city"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"
                           prefWidth="220"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- Phone -->
                <Label text="Phone Number" 
                       GridPane.rowIndex="0" GridPane.columnIndex="2"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="phoneField" 
                           promptText="e.g., 03-12345678"
                           GridPane.rowIndex="1" GridPane.columnIndex="2"
                           prefWidth="200"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>


            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets top="20"/>
                </VBox.margin>
                
                <Button text="➕ Add Branch" 
                        onAction="#handleAdd"
                        style="-fx-background-color: #27ae60; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
                <Button text="✏️ Update" 
                        onAction="#handleUpdate"
                        style="-fx-background-color: #f39c12; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
				<Button fx:id="deleteBtn"
				        text="🗑️ Delete" 
				        onAction="#handleDelete"
				        style="-fx-background-color: #e74c3c; 
				               -fx-text-fill: white; 
				               -fx-font-size: 13px; 
				               -fx-font-weight: 600; 
				               -fx-background-radius: 5; 
				               -fx-padding: 10 20 10 20;
				               -fx-cursor: hand;"/>

                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button text="← Back" 
                        onAction="#handleBack"
                        style="-fx-background-color: #95a5a6; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>