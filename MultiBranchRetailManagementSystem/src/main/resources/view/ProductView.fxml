<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProductController"
            style="-fx-background-color: #f5f5f5;">

    <top>
    <Label fx:id="userInfoLabel"
       text=""
       style="-fx-font-size: 13px;
              -fx-font-weight: bold;
              -fx-text-fill: #555;" />

        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📦" style="-fx-font-size: 24px;"/>
                <Label text="Product Management"
                       style="-fx-font-size: 20px; 
                              -fx-font-weight: bold; 
                              -fx-text-fill: #2c3e50;"/>
            </HBox>
            
            <!-- Search Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets top="15"/>
                </VBox.margin>
                
                <TextField fx:id="searchField"
                           promptText="Search by product name..."
                           prefWidth="350"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <Button text="🔍 Search" 
                        onAction="#handleSearch"
                        style="-fx-background-color: #3498db; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
                <Button text="🔄 Refresh" 
                        onAction="#loadProducts"
                        style="-fx-background-color: #95a5a6; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>
            <padding>
                <Insets top="15" right="15" bottom="0" left="15"/>
            </padding>
            
            <TableView fx:id="productTable"
                       style="-fx-background-color: white; 
                              -fx-background-radius: 8;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 1);">
                <columns>
                    <TableColumn text="ID" fx:id="colId" 
                                 prefWidth="60"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Product Name" fx:id="colName" 
                                 prefWidth="200"
                                 style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn text="Category" fx:id="colCategory" 
                                 prefWidth="150"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Price (RM)" fx:id="colPrice" 
                                 prefWidth="120"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
					<TableColumn text="Cost (RM)" fx:id="colCost" 
                                 prefWidth="120"
                                 style="-fx-alignment: CENTER-RIGHT;"/>
                    <TableColumn text="Quantity" fx:id="colQuantity" 
                                 prefWidth="100"
                                 style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Branch" fx:id="colBranch" 
                                 prefWidth="150"
                                 style="-fx-alignment: CENTER;"/>
					<TableColumn fx:id="colStatus" 
                                text="Status" 
                                prefWidth="100" 
                                style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <VBox style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>
            
            <!-- Form Title -->
            <Label text="Product Details"
                   style="-fx-font-size: 15px; 
                          -fx-font-weight: 600; 
                          -fx-text-fill: #34495e;">
                <VBox.margin>
                    <Insets bottom="15"/>
                </VBox.margin>
            </Label>
            
            <!-- Form Fields -->
            <GridPane hgap="15" vgap="12">
                
                <!-- Product Name -->
                <Label text="Product Name" 
                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="nameField" 
                           promptText="Enter product name"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"
                           prefWidth="250"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- Category -->
                <Label text="Category" 
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="categoryField" 
                           promptText="Enter category"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"
                           prefWidth="200"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- Price -->
                <Label text="Price (RM)" 
                       GridPane.rowIndex="0" GridPane.columnIndex="2"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="priceField" 
                           promptText="0.00"
                           GridPane.rowIndex="1" GridPane.columnIndex="2"
                           prefWidth="150"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- Quantity -->
                <Label text="Quantity" 
                       GridPane.rowIndex="0" GridPane.columnIndex="3"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <TextField fx:id="quantityField" 
                           promptText="0"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"
                           prefWidth="120"
                           style="-fx-background-color: #f8f9fa; 
                                  -fx-background-radius: 5; 
                                  -fx-border-color: #e0e0e0; 
                                  -fx-border-radius: 5; 
                                  -fx-padding: 10;
                                  -fx-font-size: 13px;
                                  -fx-prompt-text-fill: #95a5a6;"/>
                
                <!-- Branch -->
                <Label text="Branch" 
                       GridPane.rowIndex="0" GridPane.columnIndex="4"
                       style="-fx-font-size: 12px; 
                              -fx-font-weight: 600; 
                              -fx-text-fill: #34495e;"/>
                <ComboBox fx:id="branchComboBox" 
                          promptText="Select Branch"
                          GridPane.rowIndex="1" GridPane.columnIndex="4"
                          prefWidth="180"
                          style="-fx-background-color: #f8f9fa; 
                                 -fx-background-radius: 5; 
                                 -fx-border-color: #e0e0e0; 
                                 -fx-border-radius: 5;
                                 -fx-font-size: 13px;"/>
            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox.margin>
                    <Insets top="20"/>
                </VBox.margin>
                
                <Button text="➕ Add Product" 
                        onAction="#handleAdd"
                        style="-fx-background-color: #27ae60; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
                <Button text="✏️ Update" 
                        onAction="#handleUpdate"
                        style="-fx-background-color: #f39c12; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
                
				<Button fx:id="deleteBtn"
				        text="🗑️ Delete" 
				        onAction="#handleDelete"
				        style="-fx-background-color: #e74c3c; 
				               -fx-text-fill: white; 
				               -fx-font-size: 13px; 
				               -fx-font-weight: 600; 
				               -fx-background-radius: 5; 
				               -fx-padding: 10 20 10 20;
				               -fx-cursor: hand;"/>

                
                <Region HBox.hgrow="ALWAYS"/>
                
                <Button text="← Back" 
                        onAction="#handleBack"
                        style="-fx-background-color: #95a5a6; 
                               -fx-text-fill: white; 
                               -fx-font-size: 13px; 
                               -fx-font-weight: 600; 
                               -fx-background-radius: 5; 
                               -fx-padding: 10 20 10 20;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>