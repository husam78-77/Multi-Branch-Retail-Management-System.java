<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ReportsMenuController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📊" style="-fx-font-size: 28px;"/>
                <VBox spacing="3">
                    <Label text="Reports Center"
                           style="-fx-font-size: 20px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"/>
                    <Label text="Select a report type to view detailed analytics"
                           style="-fx-font-size: 13px; 
                                  -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Available Reports"
                   style="-fx-font-size: 16px; 
                          -fx-font-weight: 600; 
                          -fx-text-fill: #34495e;"/>

            <HBox spacing="30" alignment="CENTER">
                
                <!-- Sales Per Branch Report Card -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: white; 
                             -fx-background-radius: 10; 
                             -fx-padding: 40;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      prefWidth="280" prefHeight="300">
                    
                    <!-- Icon -->
                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: #e3f2fd; 
                                 -fx-background-radius: 50; 
                                 -fx-padding: 20;"
                          prefWidth="80" prefHeight="80">
                        <Label text="🏢" style="-fx-font-size: 36px;"/>
                    </VBox>
                    
                    <!-- Title -->
                    <Label text="Sales Per Branch"
                           style="-fx-font-size: 16px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"
                           wrapText="true"
                           maxWidth="240"
                           alignment="CENTER"/>
                    
                    <!-- Description -->
                    <Label text="View total sales performance broken down by each branch location"
                           style="-fx-font-size: 12px; 
                                  -fx-text-fill: #7f8c8d;
                                  -fx-text-alignment: center;"
                           wrapText="true"
                           maxWidth="240"
                           alignment="CENTER"/>
                    
                    <!-- Button -->
                    <Button text="View Report →" 
                            onAction="#handleBranchReport"
                            prefWidth="200"
                            style="-fx-background-color: #3498db; 
                                   -fx-text-fill: white; 
                                   -fx-font-size: 13px; 
                                   -fx-font-weight: 600; 
                                   -fx-background-radius: 5; 
                                   -fx-padding: 12;
                                   -fx-cursor: hand;">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Button>
                </VBox>

                <!-- Best Selling Products Report Card -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: white; 
                             -fx-background-radius: 10; 
                             -fx-padding: 40;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                      prefWidth="280" prefHeight="300">
                    
                    <!-- Icon -->
                    <VBox alignment="CENTER" spacing="5"
                          style="-fx-background-color: #fff3e0; 
                                 -fx-background-radius: 50; 
                                 -fx-padding: 20;"
                          prefWidth="80" prefHeight="80">
                        <Label text="⭐" style="-fx-font-size: 36px;"/>
                    </VBox>
                    
                    <!-- Title -->
                    <Label text="Best Selling Products"
                           style="-fx-font-size: 16px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"
                           wrapText="true"
                           maxWidth="240"
                           alignment="CENTER"/>
                    
                    <!-- Description -->
                    <Label text="Discover your top-performing products ranked by total units sold"
                           style="-fx-font-size: 12px; 
                                  -fx-text-fill: #7f8c8d;
                                  -fx-text-alignment: center;"
                           wrapText="true"
                           maxWidth="240"
                           alignment="CENTER"/>
                    
                    <!-- Button -->
                    <Button text="View Report →" 
                            onAction="#handleProductReport"
                            prefWidth="200"
                            style="-fx-background-color: #f39c12; 
                                   -fx-text-fill: white; 
                                   -fx-font-size: 13px; 
                                   -fx-font-weight: 600; 
                                   -fx-background-radius: 5; 
                                   -fx-padding: 12;
                                   -fx-cursor: hand;">
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </Button>
                </VBox>

            </HBox>

            <!-- Info Box -->
            <HBox spacing="10" alignment="CENTER"
                  style="-fx-background-color: white; 
                         -fx-background-radius: 8; 
                         -fx-padding: 15;
                         -fx-border-color: #e0e0e0;
                         -fx-border-radius: 8;
                         -fx-border-width: 1;"
                  maxWidth="600">
                <VBox.margin>
                    <Insets top="20"/>
                </VBox.margin>
                <Label text="💡" style="-fx-font-size: 18px;"/>
                <Label text="Reports are generated in real-time from your sales database. Use these insights to make data-driven business decisions."
                       style="-fx-font-size: 12px; 
                              -fx-text-fill: #7f8c8d;"
                       wrapText="true"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" 
              style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <Button text="← Back to Dashboard" 
                    onAction="#handleBack"
                    style="-fx-background-color: #95a5a6; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
