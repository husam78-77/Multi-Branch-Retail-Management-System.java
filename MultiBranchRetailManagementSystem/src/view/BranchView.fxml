<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BranchController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Branch Management"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="searchField"
                           promptText="Search by branch name"/>
                <Button text="Search" onAction="#handleSearch"/>
                <Button text="Refresh" onAction="#loadBranches"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="branchTable">

            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colName" text="Name"/>
                <TableColumn fx:id="colCity" text="City"/>
                <TableColumn fx:id="colPhone" text="Phone"/>
            </columns>

        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <GridPane hgap="10" vgap="10">
                <TextField fx:id="nameField" promptText="Branch Name"/>
                <TextField fx:id="cityField" promptText="City"/>
                <TextField fx:id="phoneField" promptText="Phone"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd"/>
                <Button text="Update" onAction="#handleUpdate"/>
                <Button text="Delete" onAction="#handleDelete"/>
                <Button text="Back" onAction="#handleBack"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
