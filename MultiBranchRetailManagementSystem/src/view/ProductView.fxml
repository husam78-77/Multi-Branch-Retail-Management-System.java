<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProductController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Product Management"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <TextField fx:id="searchField"
                           promptText="Search by product name"/>
                <Button text="Search" onAction="#handleSearch"/>
                <Button text="Refresh" onAction="#loadProducts"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="productTable">

            <columns>
                <TableColumn text="ID" fx:id="colId"/>
                <TableColumn text="Name" fx:id="colName"/>
                <TableColumn text="Category" fx:id="colCategory"/>
                <TableColumn text="Price" fx:id="colPrice"/>
                <TableColumn text="Quantity" fx:id="colQuantity"/>
                <TableColumn text="Branch" fx:id="colBranch"/>
            </columns>

        </TableView>
    </center>

    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <GridPane hgap="10" vgap="10">
                <TextField fx:id="nameField" promptText="Name"/>
                <TextField fx:id="categoryField" promptText="Category"/>
                <TextField fx:id="priceField" promptText="Price"/>
                <TextField fx:id="quantityField" promptText="Quantity"/>
				<ComboBox fx:id="branchComboBox" promptText="Select Branch"/>
            </GridPane>

            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd"/>
                <Button text="Update" onAction="#handleUpdate"/>
                <Button text="Delete" onAction="#handleDelete"/>
                <Button text="Back" onAction="#handleBack"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
