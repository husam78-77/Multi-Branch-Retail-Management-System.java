<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BestProductReportController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 6, 0, 0, 2);">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="⭐" style="-fx-font-size: 28px;"/>
                <VBox spacing="3">
                    <Label text="Best Selling Products Report"
                           style="-fx-font-size: 20px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"/>
                    <Label text="Top performing products ranked by total units sold"
                           style="-fx-font-size: 13px; 
                                  -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <!-- Report Card Container -->
            <VBox style="-fx-background-color: white; 
                        -fx-background-radius: 10;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                  maxWidth="900"
                  VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <!-- Ranking Info -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <VBox.margin>
                        <Insets bottom="15"/>
                    </VBox.margin>
                    <Label text="📈" style="-fx-font-size: 16px;"/>
                    <Label text="Product Performance Ranking"
                           style="-fx-font-size: 14px; 
                                  -fx-font-weight: 600; 
                                  -fx-text-fill: #34495e;"/>
                </HBox>
                
                <Separator/>
                
                <!-- Table -->
                <TableView fx:id="productReportTable"
                           style="-fx-background-color: transparent;"
                           VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="15"/>
                    </VBox.margin>
                    
                    <columns>
                        <TableColumn fx:id="colProduct" 
                                     text="Product Name" 
                                     prefWidth="500"
                                     style="-fx-alignment: CENTER-LEFT;"/>
                        <TableColumn fx:id="colTotalSold" 
                                     text="Units Sold" 
                                     prefWidth="200"
                                     style="-fx-alignment: CENTER;"/>
                    </columns>
                    
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Performance Note -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: #f8f9fa; 
                             -fx-background-radius: 5; 
                             -fx-padding: 10;">
                    <VBox.margin>
                        <Insets top="15"/>
                    </VBox.margin>
                    <Label text="💡" style="-fx-font-size: 14px;"/>
                    <Label text="Tip: Focus marketing efforts on top-performing products to maximize revenue"
                           style="-fx-font-size: 11px; 
                                  -fx-text-fill: #7f8c8d;"
                           wrapText="true"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" 
              style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <Button text="📄 Download PDF" 
                    onAction="#handleDownloadPDF"
                    style="-fx-background-color: #e74c3c; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button text="← Back" 
                    onAction="#handleBack"
                    style="-fx-background-color: #95a5a6; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 20 10 20;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>
