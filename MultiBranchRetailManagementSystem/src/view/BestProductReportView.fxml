<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BestProductReportController">

    <top>
        <Label text="Best Selling Products"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <TableView fx:id="productReportTable">
            <columns>
                <TableColumn fx:id="colProduct" text="Product Name"/>
                <TableColumn fx:id="colTotalSold" text="Total Sold"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" padding="10">
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>
