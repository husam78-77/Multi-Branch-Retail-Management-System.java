<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: white; 
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="📊" style="-fx-font-size: 28px;"/>
                <VBox spacing="2">
                    <Label text="Retail Management System"
                           style="-fx-font-size: 20px; 
                                  -fx-font-weight: bold; 
                                  -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="welcomeLabel"
                           style="-fx-font-size: 14px; 
                                  -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <Label text="Main Menu"
                   style="-fx-font-size: 16px; 
                          -fx-font-weight: 600; 
                          -fx-text-fill: #34495e;"/>

            <GridPane hgap="20" vgap="20" alignment="CENTER">
                
                <!-- Products Card -->
                <StackPane GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white; 
                                 -fx-background-radius: 10; 
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          prefWidth="200" prefHeight="150">
                        <Label text="📦" style="-fx-font-size: 36px;"/>
                        <Label text="Manage Products"
                               style="-fx-text-fill: #2c3e50; 
                                      -fx-font-size: 14px; 
                                      -fx-font-weight: bold;"/>
                        <Label text="View and manage inventory"
                               style="-fx-font-size: 11px; 
                                      -fx-text-fill: #95a5a6;
                                      -fx-text-alignment: center;"
                               wrapText="true" maxWidth="160"/>
                    </VBox>
                    <Button fx:id="productsBtn" 
                            opacity="0" 
                            maxWidth="Infinity" 
                            maxHeight="Infinity"
                            style="-fx-cursor: hand;"/>
                </StackPane>

                <!-- Branches Card -->
                <StackPane GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white; 
                                 -fx-background-radius: 10; 
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          prefWidth="200" prefHeight="150">
                        <Label text="🏢" style="-fx-font-size: 36px;"/>
                        <Label text="Manage Branches"
                               style="-fx-text-fill: #2c3e50; 
                                      -fx-font-size: 14px; 
                                      -fx-font-weight: bold;"/>
                        <Label text="Configure branch locations"
                               style="-fx-font-size: 11px; 
                                      -fx-text-fill: #95a5a6;
                                      -fx-text-alignment: center;"
                               wrapText="true" maxWidth="160"/>
                    </VBox>
                    <Button fx:id="branchesBtn" 
                            opacity="0" 
                            maxWidth="Infinity" 
                            maxHeight="Infinity"
                            style="-fx-cursor: hand;"/>
                </StackPane>

                <!-- Sales Card -->
                <StackPane GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white; 
                                 -fx-background-radius: 10; 
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          prefWidth="200" prefHeight="150">
                        <Label text="💰" style="-fx-font-size: 36px;"/>
                        <Label text="Sales"
                               style="-fx-text-fill: #2c3e50; 
                                      -fx-font-size: 14px; 
                                      -fx-font-weight: bold;"/>
                        <Label text="Process transactions"
                               style="-fx-font-size: 11px; 
                                      -fx-text-fill: #95a5a6;
                                      -fx-text-alignment: center;"
                               wrapText="true" maxWidth="160"/>
                    </VBox>
                    <Button fx:id="salesBtn" 
                            opacity="0" 
                            maxWidth="Infinity" 
                            maxHeight="Infinity"
                            style="-fx-cursor: hand;"/>
                </StackPane>

                <!-- Reports Card -->
                <StackPane GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white; 
                                 -fx-background-radius: 10; 
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          prefWidth="200" prefHeight="150">
                        <Label text="📄" style="-fx-font-size: 36px;"/>
                        <Label text="Reports"
                               style="-fx-text-fill: #2c3e50; 
                                      -fx-font-size: 14px; 
                                      -fx-font-weight: bold;"/>
                        <Label text="Generate business reports"
                               style="-fx-font-size: 11px; 
                                      -fx-text-fill: #95a5a6;
                                      -fx-text-alignment: center;"
                               wrapText="true" maxWidth="160"/>
                    </VBox>
                    <Button fx:id="reportsBtn" 
                            opacity="0" 
                            maxWidth="Infinity" 
                            maxHeight="Infinity"
                            style="-fx-cursor: hand;"/>
                </StackPane>

                <!-- Charts Card -->
                <StackPane GridPane.rowIndex="2" GridPane.columnIndex="0"
                           GridPane.columnSpan="2"
                           GridPane.halignment="CENTER">
                    <VBox alignment="CENTER" spacing="10"
                          style="-fx-background-color: white; 
                                 -fx-background-radius: 10; 
                                 -fx-padding: 30;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          prefWidth="200" prefHeight="150">
                        <Label text="📊" style="-fx-font-size: 36px;"/>
                        <Label text="Charts"
                               style="-fx-text-fill: #2c3e50; 
                                      -fx-font-size: 14px; 
                                      -fx-font-weight: bold;"/>
                        <Label text="Visualize data and analytics"
                               style="-fx-font-size: 11px; 
                                      -fx-text-fill: #95a5a6;
                                      -fx-text-alignment: center;"
                               wrapText="true" maxWidth="160"/>
                    </VBox>
                    <Button fx:id="chartsBtn" 
                            opacity="0" 
                            maxWidth="Infinity" 
                            maxHeight="Infinity"
                            style="-fx-cursor: hand;"/>
                </StackPane>

            </GridPane>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" 
              style="-fx-background-color: white; 
                     -fx-border-color: #e0e0e0; 
                     -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            <Button text="🚪 Logout" 
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; 
                           -fx-text-fill: white; 
                           -fx-font-size: 13px; 
                           -fx-font-weight: 600; 
                           -fx-background-radius: 5; 
                           -fx-padding: 10 30 10 30;
                           -fx-cursor: hand;"/>
        </HBox>
    </bottom>

</BorderPane>