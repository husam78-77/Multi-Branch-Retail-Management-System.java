<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController">

    <top>
        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="15" vgap="15" alignment="CENTER">
            <padding>
                <Insets top="20"/>
            </padding>

            <Button fx:id="productsBtn" text="Manage Products"
                    GridPane.rowIndex="0" GridPane.columnIndex="0"
                    prefWidth="180"/>

            <Button fx:id="branchesBtn" text="Manage Branches"
                    GridPane.rowIndex="0" GridPane.columnIndex="1"
                    prefWidth="180"/>

            <Button fx:id="salesBtn" text="Sales"
                    GridPane.rowIndex="1" GridPane.columnIndex="0"
                    prefWidth="180"/>

            <Button fx:id="reportsBtn" text="Reports"
                    GridPane.rowIndex="1" GridPane.columnIndex="1"
                    prefWidth="180"/>

            <Button fx:id="chartsBtn" text="Charts"
                    GridPane.rowIndex="2" GridPane.columnIndex="0"
                    prefWidth="180"/>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </bottom>

</BorderPane>
